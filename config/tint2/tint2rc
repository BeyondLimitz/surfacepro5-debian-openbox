# Background 1: panel
rounded = 0
border_width = 0
background_color = #1a1a1a 90
border_color = #000000 0

# Background 2: active task
rounded = 6
border_width = 1
background_color = #ffffff 12
border_color = #ffffff 20

# Panel
panel_monitor = primary
panel_position = bottom center horizontal
panel_size = 100% 72
panel_margin = 0 0
panel_padding = 12 6 12
panel_background_id = 1
panel_layer = top
panel_dock = 0
strut_policy = follow_size
autohide = 0
wm_menu = 1

# Taskbar, tray, battery, governor, clock
panel_items = TSBEC

# Taskbar
taskbar_mode = single_desktop
taskbar_padding = 4 0 4
taskbar_background_id = 0
taskbar_name = 0

# Tasks
task_text = 1
task_icon = 1
task_centered = 0
task_maximum_size = 320 60
task_padding = 12 6 8
task_font = DejaVu Sans 11
task_font_color = #cccccc 100
task_active_font_color = #ffffff 100
task_background_id = 0
task_active_background_id = 2

mouse_left = toggle_iconify
mouse_middle = close
mouse_right = toggle
mouse_scroll_up = prev_task
mouse_scroll_down = next_task

# Tray
systray_padding = 8 0 8
systray_background_id = 0
systray_sort = ascending
systray_icon_size = 32

# Battery
battery_hide = never
battery_low_status = 15
battery_low_cmd = notify-send -u critical "Surface battery" "Battery below 15%"
bat1_format = %p
bat2_format = %s
bat1_font = DejaVu Sans Bold 11
bat2_font = DejaVu Sans 9
battery_font_color = #ffffff 100
battery_padding = 12 0 12
battery_background_id = 0

# Governor executor
execp = new
execp_command = "$HOME/.local/libexec/surface-openbox/surface-governor"
execp_interval = 10
execp_has_icon = 0
execp_font = DejaVu Sans 10
execp_font_color = #dddddd 100
execp_padding = 12 0 12
execp_background_id = 0

# Clock
time1_format = %H:%M
time1_font = DejaVu Sans Bold 12
time2_format = %a %d %b
time2_font = DejaVu Sans 9
clock_font_color = #ffffff 100
clock_padding = 12 0 12
clock_background_id = 0

# Tooltips
tooltip_show_timeout = 0.5
tooltip_hide_timeout = 0.1
tooltip_padding = 10 10
tooltip_background_id = 1
tooltip_font = DejaVu Sans 10
tooltip_font_color = #ffffff 100
