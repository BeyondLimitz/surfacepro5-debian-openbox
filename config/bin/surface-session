#!/usr/bin/env bash
set -Eeuo pipefail

children=()

cleanup() {
    trap - EXIT HUP INT TERM

    local pid
    for pid in "${children[@]}"; do
        kill "$pid" 2>/dev/null || true
    done

    wait 2>/dev/null || true
}

trap cleanup EXIT
trap 'exit 0' HUP INT TERM

xsetroot -solid '#20242b'

dunst &
children+=("$!")

picom --config "$HOME/.config/picom/picom.conf" &
children+=("$!")

tint2 -c "$HOME/.config/tint2/tint2rc" &
children+=("$!")

openbox-session &
wm_pid="$!"
children+=("$wm_pid")

status=0
wait "$wm_pid" || status="$?"
exit "$status"
