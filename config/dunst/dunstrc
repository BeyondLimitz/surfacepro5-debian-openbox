[global]
    font = DejaVu Sans 12
    width = 480
    height = 240
    origin = top-right
    offset = 24x24
    frame_width = 2
    padding = 16
    horizontal_padding = 16

[urgency_low]
    background = "#20242b"
    foreground = "#dddddd"
    timeout = 5

[urgency_normal]
    background = "#20242b"
    foreground = "#ffffff"
    timeout = 8

[urgency_critical]
    background = "#702020"
    foreground = "#ffffff"
    timeout = 0
